FROM node:20-alpine AS builder
WORKDIR /app
COPY greenshield/package*.json ./
RUN npm ci --no-audit --no-fund
COPY greenshield/ .
# Empty API base → the SPA calls /api on its own origin, which nginx proxies to the backend.
ENV VITE_API_URL=""
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY docker/nginx-greenshield.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
